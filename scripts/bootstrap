#!/usr/bin/env bash

set -euo pipefail


# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

REPO="${ENV_CONFIG_REPO:-$HOME/env_config}"

DOTFILES="$REPO/dotfiles"
PACKAGES="$REPO/packages"
USER_CONFIG="$REPO/user"
SYSTEM_CONFIG="$REPO/system"
STATE="$REPO/state"
PATCHES="$REPO/patches"

STAMP="$(date +%Y%m%d-%H%M%S)"

BACKUP_ROOT="$HOME/.local/state/env_config-bootstrap/$STAMP"


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

info()
{
    printf '\n--- %s ---\n\n' "$*"
}


warn()
{
    printf 'WARNING: %s\n' "$*" >&2
}


die()
{
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}


confirm()
{
    local prompt="$1"
    local reply

    printf '%s [y/N] ' "$prompt"
    read -r reply

    [[ "$reply" =~ ^[Yy]$ ]]
}


require_arch()
{
    [[ -f /etc/arch-release ]] \
        || die "This bootstrap is intended for Arch Linux."
}


require_not_root()
{
    (( EUID != 0 )) \
        || die "Run bootstrap as your normal user, not root."
}


require_repo()
{
    [[ -d "$REPO" ]] \
        || die "Environment repository not found: $REPO"

    [[ -d "$DOTFILES" ]] \
        || die "Missing dotfiles directory: $DOTFILES"

    [[ -d "$PACKAGES" ]] \
        || die "Missing packages directory: $PACKAGES"

    [[ -d "$STATE" ]] \
        || die "Missing state directory: $STATE"
}


backup_user_path()
{
    local target="$1"
    local rel
    local backup

    [[ -e "$target" || -L "$target" ]] || return 0

    rel="${target#$HOME/}"
    backup="$BACKUP_ROOT/user/$rel"

    mkdir -p "$(dirname "$backup")"

    cp -a "$target" "$backup"
}


same_entry()
{
    local src="$1"
    local dest="$2"

    # If either side is a symlink, both must be symlinks.
    if [[ -L "$src" || -L "$dest" ]]; then
        [[ -L "$src" && -L "$dest" ]] || return 1

        [[ "$(readlink -- "$src")" == "$(readlink -- "$dest")" ]]
        return
    fi

    if [[ -f "$src" && -f "$dest" ]]; then
        cmp -s "$src" "$dest"
        return
    fi

    return 1
}


system_safe_entry_differs()
{
    local src="$1"
    local target="$2"

    if [[ -L "$src" ]]; then

        sudo test -L "$target" || return 0

        [[ "$(readlink -- "$src")" != "$(sudo readlink -- "$target")" ]]
        return
    fi

    # Saved regular file must correspond to a real regular file,
    # not merely a symlink resolving to one.
    if sudo test -L "$target" || ! sudo test -f "$target"; then
        return 0
    fi

    ! sudo cmp -s "$src" "$target"
}


backup_system_path()
{
    local target="$1"
    local rel="${target#/}"
    local backup="$BACKUP_ROOT/system/$rel"
    local meta="$backup.env-config-meta"

    if ! sudo test -e "$target" && ! sudo test -L "$target"; then
        return 0
    fi

    mkdir -p "$(dirname "$backup")"

    # Keep the backup area private.
    mkdir -p "$BACKUP_ROOT/system"
    chmod 700 "$BACKUP_ROOT" "$BACKUP_ROOT/system"

    if sudo test -L "$target"; then

        printf 'type=symlink\n' > "$meta"

        printf 'target=%s\n' \
            "$(sudo readlink -- "$target")" \
            >> "$meta"

    elif sudo test -f "$target"; then

        # User-owned backup copy of the file contents.
        sudo cat "$target" > "$backup"

        chmod 600 "$backup"

        {
            printf 'type=file\n'

            sudo stat \
                --format='mode=%a
uid=%u
gid=%g' \
                "$target"

        } > "$meta"

    else
        warn "Refusing to back up unsupported system path type: $target"
        return 1
    fi

    chmod 600 "$meta"
}


restore_system_safe_entry()
{
    local src="$1"
    local rel="${src#$SYSTEM_CONFIG/}"
    local target="/$rel"

    local mode
    local link_target

    # Nothing to do.
    if ! system_safe_entry_differs "$src" "$target"; then
        return
    fi

    # Never replace directories with files/symlinks.
    if sudo test -d "$target" && ! sudo test -L "$target"; then
        die "Refusing to replace directory with file: $target"
    fi

    backup_system_path "$target" \
        || die "Could not back up $target"

    sudo install \
        -d \
        -o root \
        -g root \
        -m 755 \
        "$(dirname "$target")"

    # Remove an existing file/symlink only after backup succeeded.
    if sudo test -e "$target" || sudo test -L "$target"; then
        sudo rm -f -- "$target"
    fi


    if [[ -L "$src" ]]; then

        link_target="$(readlink -- "$src")"

        sudo ln \
            -s \
            -- "$link_target" "$target"

        return
    fi


    # Git reliably preserves the executable bit, but not arbitrary Unix
    # permission modes. Use sane defaults based on executable status.
    if [[ -x "$src" ]]; then
        mode=755
    else
        mode=644
    fi

    sudo install \
        -o root \
        -g root \
        -m "$mode" \
        -- "$src" "$target"
}


preview_system_safe_changes()
{
    local src
    local rel
    local target

    local -a candidates=()

    SYSTEM_SAFE_CHANGES=0

    mapfile -d '' -t candidates < <(
        system_safe_candidates
    )

    for src in "${candidates[@]}"; do

        rel="${src#$SYSTEM_CONFIG/}"
        target="/$rel"

        if ! sudo test -e "$target" \
            && ! sudo test -L "$target"
        then
            printf 'ADD       /%s\n' "$rel"
            SYSTEM_SAFE_CHANGES=$((SYSTEM_SAFE_CHANGES + 1))
            continue
        fi

        if system_safe_entry_differs "$src" "$target"; then
            printf 'DIFFER    /%s\n' "$rel"
            SYSTEM_SAFE_CHANGES=$((SYSTEM_SAFE_CHANGES + 1))
        fi
    done
}


restore_system_safe()
{
    local src
    local -a candidates=()

    info "Safe system configuration restore"

    sudo -v \
        || die "sudo access is required to restore system configuration."

    echo "The following saved system configuration differs:"
    echo

    preview_system_safe_changes

    if (( SYSTEM_SAFE_CHANGES == 0 )); then
        echo "No system-safe configuration changes are required."
        return
    fi

    echo
    echo "$SYSTEM_SAFE_CHANGES system-safe entries would be restored."
    echo
    echo "Existing files will first be backed up under:"
    echo
    echo "  $BACKUP_ROOT/system"
    echo

    confirm "Restore these system configuration files?" \
        || return

    mapfile -d '' -t candidates < <(
        system_safe_candidates
    )

    echo

    for src in "${candidates[@]}"; do

        if system_safe_entry_differs \
            "$src" \
            "/${src#$SYSTEM_CONFIG/}"
        then
            printf 'Restoring /%s\n' \
                "${src#$SYSTEM_CONFIG/}"

            restore_system_safe_entry "$src"
        fi

    done


    # Custom systemd unit/drop-in files may have changed.
    sudo systemctl daemon-reload


    echo
    echo "Verifying restored system-safe configuration:"
    echo

    preview_system_safe_changes

    if (( SYSTEM_SAFE_CHANGES == 0 )); then
        echo
        echo "All system-safe entries now match the saved environment."
    else
        echo
        warn "$SYSTEM_SAFE_CHANGES entries still differ after restoration."
    fi

    echo
    echo "Some restored settings may require a service restart or reboot."
}


# ---------------------------------------------------------------------------
# Packages
# ---------------------------------------------------------------------------

install_official_packages()
{
    local -a packages=()

    [[ -f "$PACKAGES/official.txt" ]] \
        || die "Missing packages/official.txt"

    mapfile -t packages < <(
        grep -Ev '^[[:space:]]*(#|$)' \
            "$PACKAGES/official.txt"
    )

    if (( ${#packages[@]} == 0 )); then
        info "No official packages to install"
        return
    fi

    info "Installing official Arch packages"

    sudo pacman -Syu --needed "${packages[@]}"
}


bootstrap_yay()
{
    local helper_pkg="yay"
    local tmp

    command -v yay >/dev/null 2>&1 && return 0

    if grep -qx 'yay-bin' "$PACKAGES/foreign.txt" 2>/dev/null; then
        helper_pkg="yay-bin"
    elif grep -qx 'yay' "$PACKAGES/foreign.txt" 2>/dev/null; then
        helper_pkg="yay"
    fi

    warn "yay is not currently installed."

    confirm "Bootstrap $helper_pkg from the AUR?" \
        || return 1

    sudo pacman -S --needed base-devel git

    tmp="$(mktemp -d)"

    git clone \
        "https://aur.archlinux.org/${helper_pkg}.git" \
        "$tmp/$helper_pkg"

    echo
    echo "Reviewing PKGBUILD before building:"
    echo

    "${PAGER:-less}" "$tmp/$helper_pkg/PKGBUILD"

    confirm "Build and install $helper_pkg?" || {
        rm -rf "$tmp"
        return 1
    }

    (
        cd "$tmp/$helper_pkg"
        makepkg -si
    )

    rm -rf "$tmp"
}


install_foreign_packages()
{
    local -a packages=()

    [[ -f "$PACKAGES/foreign.txt" ]] || return 0

    bootstrap_yay || {
        warn "Skipping foreign/AUR packages."
        return
    }

    mapfile -t packages < <(
        grep -Ev \
            '^[[:space:]]*(#|$)|^yay$|^yay-bin$' \
            "$PACKAGES/foreign.txt"
    )

    if (( ${#packages[@]} == 0 )); then
        return
    fi

    info "Installing foreign / AUR packages"

    yay -S --needed "${packages[@]}"
}


install_code_extensions()
{
    [[ -f "$PACKAGES/code-extensions.txt" ]] || return

    if ! command -v code >/dev/null 2>&1; then
        warn "Code OSS not installed; skipping extensions."
        return
    fi

    info "Installing Code extensions"

    while IFS= read -r extension; do
        [[ -n "$extension" ]] || continue

        echo "$extension"

        code --install-extension "$extension" \
            >/dev/null 2>&1 \
            || warn "Could not install extension: $extension"

    done < "$PACKAGES/code-extensions.txt"
}


install_packages()
{
    install_official_packages
    install_foreign_packages
    install_code_extensions
}


# ---------------------------------------------------------------------------
# GNU Stow dotfiles
# ---------------------------------------------------------------------------

backup_stow_conflicts()
{
    local package="$1"
    local package_root="$DOTFILES/$package"

    local item
    local rel
    local target
    local resolved

    while IFS= read -r -d '' item; do

        rel="${item#$package_root/}"
        target="$HOME/$rel"

        if [[ -e "$target" || -L "$target" ]]; then

            resolved="$(
                readlink -f -- "$target" 2>/dev/null \
                    || true
            )"

            # Whether the final component or one of its parents is symlinked,
            # don't touch it if it resolves back into this Stow package.
            case "$resolved" in
                "$package_root"|"$package_root"/*)
                    continue
                    ;;
            esac

            warn "Backing up conflicting file: $target"

            backup_user_path "$target"
            rm -rf -- "$target"
        fi

    done < <(
        find "$package_root" \
            \( -type f -o -type l \) \
            -print0
    )
}


restore_dotfiles()
{
    local package
    local name

    command -v stow >/dev/null 2>&1 \
        || die "GNU Stow is not installed."

    info "Restoring Stow-managed dotfiles"

    for package in "$DOTFILES"/*; do
        [[ -d "$package" ]] || continue

        name="$(basename "$package")"

        echo "$name"

        backup_stow_conflicts "$name"

        stow \
            --dir="$DOTFILES" \
            --target="$HOME" \
            --restow \
            "$name"
    done
}


# ---------------------------------------------------------------------------
# Vim plugins
# ---------------------------------------------------------------------------

restore_vim_plugins()
{
    local inventory="$STATE/vim-plugin-git.txt"

    local rel
    local remote
    local branch
    local commit
    local saved_dirty

    local target
    local name
    local patch

    [[ -f "$inventory" ]] || {
        warn "No Vim plugin inventory found."
        return
    }

    info "Restoring Vim plugins"

    while IFS=$'\t' read -r \
        rel remote branch commit saved_dirty
    do
        [[ -n "$rel" ]] || continue

        target="$HOME/$rel"
        name="$(basename "$target")"
        patch="$PATCHES/vim-${name}.patch"

        echo "$name"

        if [[ -d "$target/.git" ]]; then

            if [[ -n "$(git -C "$target" status --porcelain)" ]]; then
                warn "$name already contains local changes; leaving it alone."
                continue
            fi

            if ! git -C "$target" cat-file -e "${commit}^{commit}" 2>/dev/null; then
                echo "  fetching missing saved commit"
                git -C "$target" fetch --all --tags
            fi

        elif [[ -e "$target" ]]; then

            warn "$target exists but is not a Git repository; skipping."
            continue

        else
            mkdir -p "$(dirname "$target")"

            [[ "$remote" != "-" ]] \
                || die "No remote recorded for Vim plugin: $name"
            
            [[ "$commit" != "-" ]] \
                || die "No commit recorded for Vim plugin: $name"

            git clone "$remote" "$target"
        fi

        if [[ "$branch" == "DETACHED" ]]; then
            git -C "$target" checkout --detach "$commit"
        else
            # Keep the plugin on its saved branch while pinning it to
            # the exact commit recorded by env_save.
            git -C "$target" checkout -B "$branch" "$commit"
        
            # Restore upstream tracking when that branch exists on origin.
            if git -C "$target" show-ref \
                --verify \
                --quiet \
                "refs/remotes/origin/$branch"
            then
                git -C "$target" branch \
                    --set-upstream-to="origin/$branch" \
                    "$branch" \
                    >/dev/null
            fi
        fi

        if [[ "$saved_dirty" == "DIRTY" ]]; then
        
            [[ -f "$patch" ]] \
                || die "$name was DIRTY in the saved environment but no patch exists."
        
            echo "  applying $(basename "$patch")"
        
            git -C "$target" apply --check "$patch" \
                || die "Saved patch does not apply cleanly to $name."
        
            git -C "$target" apply "$patch"
        fi

    done < "$inventory"
}


# ---------------------------------------------------------------------------
# Saved user configuration
# ---------------------------------------------------------------------------

restore_user_tree()
{
    local src_root="$1"

    local src
    local rel
    local target

    [[ -d "$src_root" ]] || return

    while IFS= read -r -d '' src; do

        rel="${src#$src_root/}"
        target="$HOME/$rel"

        # Real directory, but NOT a symlink to a directory.
        if [[ -d "$src" && ! -L "$src" ]]; then

            # Don't follow an existing destination symlink.
            if [[ -L "$target" ]] \
                || [[ -e "$target" && ! -d "$target" ]]
            then
                warn "Backing up conflicting path: $target"

                backup_user_path "$target"
                rm -rf -- "$target"
            fi

            mkdir -p -- "$target"
            continue
        fi

        if [[ -e "$target" || -L "$target" ]]; then

            if same_entry "$src" "$target"; then
                continue
            fi

            warn "Backing up conflicting file: $target"

            backup_user_path "$target"
            rm -rf -- "$target"
        fi

        mkdir -p -- "$(dirname "$target")"

        cp -a -- "$src" "$target"

    done < <(
        find "$src_root" \
            -mindepth 1 \
            -print0 \
            | LC_ALL=C sort -z
    )
}


restore_user_config()
{
    info "Restoring saved user configuration"

    echo "Existing conflicting files will be backed up under:"
    echo
    echo "  $BACKUP_ROOT"
    echo

    confirm "Restore user configuration?" || return

    restore_user_tree "$USER_CONFIG"
    
    if [[ -d "$HOME/.ssh" ]]; then
        chmod 700 "$HOME/.ssh"
    fi
    
    if [[ -f "$HOME/.ssh/config" ]]; then
        chmod 600 "$HOME/.ssh/config"
    fi
}


# ---------------------------------------------------------------------------
# Safe system configuration restore
# ---------------------------------------------------------------------------

system_safe_candidates()
{
    local rel
    local src

    local -a safe_trees=(
        "etc/pacman.d/hooks"

        "etc/modprobe.d"
        "etc/modules-load.d"

        "etc/udev/rules.d"

        "etc/sysctl.d"
        "etc/tmpfiles.d"

        "etc/sddm.conf.d"
        "etc/X11/xorg.conf.d"
        "etc/environment.d"

        "etc/NetworkManager/conf.d"
        "etc/NetworkManager/dispatcher.d"

        "etc/systemd/logind.conf.d"
        "etc/systemd/sleep.conf.d"
        "etc/systemd/resolved.conf.d"
        "etc/systemd/timesyncd.conf.d"
        "etc/systemd/journald.conf.d"

        "etc/security/limits.d"
        "etc/ssh/sshd_config.d"

        "usr/local/bin"
    )

    # Ordinary configuration trees: regular files and deliberate symlinks.
    for rel in "${safe_trees[@]}"; do

        src="$SYSTEM_CONFIG/$rel"

        [[ -d "$src" ]] || continue

        find "$src" \
            \( -type f -o -type l \) \
            -print0

    done


    # systemd's /etc/systemd/system and /etc/systemd/user trees need
    # special handling. env_save also captures enablement/alias symlinks
    # here, and those should NOT be blindly transplanted.
    for rel in \
        "etc/systemd/system" \
        "etc/systemd/user"
    do

        src="$SYSTEM_CONFIG/$rel"

        [[ -d "$src" ]] || continue

        # Restore actual custom unit files and drop-ins only.
        # Service enablement is reconstructed separately from state/.
        find "$src" \
            -type f \
            -print0

    done
}


# ---------------------------------------------------------------------------
# System configuration review
# ---------------------------------------------------------------------------

review_system_config()
{
    local src
    local rel
    local target
    local src_link
    local target_link
    local differences=0
    local efi_available=1

    [[ -d "$SYSTEM_CONFIG" ]] || {
        warn "No saved system configuration found."
        return
    }

    info "System configuration differences"

    sudo -v \
        || die "sudo access is required to review system configuration."

    if [[ -d "$SYSTEM_CONFIG/efi" ]] && ! mountpoint -q /efi; then
        warn "/efi is not mounted; EFI configuration comparisons will be skipped."
        efi_available=0
    fi

    while IFS= read -r -d '' src; do

        rel="${src#$SYSTEM_CONFIG/}"
        target="/$rel"

        if [[ "$rel" == efi/* ]] && (( ! efi_available )); then
            continue
        fi

        # Target paths may not be traversable by the normal user.
        if ! sudo test -e "$target" && ! sudo test -L "$target"; then
            printf 'MISSING   /%s\n' "$rel"
            differences=$((differences + 1))
            continue
        fi

        if [[ -L "$src" ]]; then

            if ! sudo test -L "$target"; then
                printf 'DIFFER   /%s\n' "$rel"
                differences=$((differences + 1))
                continue
            fi

            src_link="$(readlink -- "$src")"
            target_link="$(sudo readlink -- "$target")"

            if [[ "$src_link" != "$target_link" ]]; then
                printf 'DIFFER   /%s\n' "$rel"
                differences=$((differences + 1))
            fi

        elif [[ -f "$src" ]]; then

            # A saved regular file should remain a regular file, not a symlink
            # that merely happens to resolve to identical contents.
            if sudo test -L "$target" \
                || ! sudo test -f "$target" \
                || ! sudo cmp -s "$src" "$target"
            then
                printf 'DIFFER   /%s\n' "$rel"
                differences=$((differences + 1))
            fi
        fi

    done < <(
        find "$SYSTEM_CONFIG" \
            \( -type f -o -type l \) \
            -print0 \
            | LC_ALL=C sort -z
    )

    if (( differences == 0 )); then
        echo "All saved system configuration entries match this machine."
    else
        echo
        echo "$differences system configuration entries differ."
    fi
}


review_services()
{
    local tmp_system
    local tmp_user

    tmp_system="$(mktemp)"
    tmp_user="$(mktemp)"

    info "Systemd enablement differences"

    if [[ -f "$STATE/systemd-system-enabled.txt" ]]; then

        if systemctl list-unit-files \
            --state=enabled \
            --no-legend \
            --no-pager \
            | awk '{print $1}' \
            | LC_ALL=C sort \
            > "$tmp_system"
        then
            echo "Saved system units not currently enabled:"
            echo

            comm -23 \
                "$STATE/systemd-system-enabled.txt" \
                "$tmp_system"

            echo
            echo "Currently enabled system units not in saved state:"
            echo

            comm -13 \
                "$STATE/systemd-system-enabled.txt" \
                "$tmp_system"
        else
            warn "Could not query system systemd units."
        fi

    else
        warn "Saved systemd system-unit state is missing."
    fi


    echo

    if [[ -f "$STATE/systemd-user-enabled.txt" ]]; then

        if systemctl --user list-unit-files \
            --state=enabled \
            --no-legend \
            --no-pager \
            2>/dev/null \
            | awk '{print $1}' \
            | LC_ALL=C sort \
            > "$tmp_user"
        then
            echo "Saved user units not currently enabled:"
            echo

            comm -23 \
                "$STATE/systemd-user-enabled.txt" \
                "$tmp_user"

            echo
            echo "Currently enabled user units not in saved state:"
            echo

            comm -13 \
                "$STATE/systemd-user-enabled.txt" \
                "$tmp_user"
        else
            warn "Could not query the user systemd manager."
        fi

    else
        warn "Saved systemd user-unit state is missing."
    fi

    rm -f "$tmp_system" "$tmp_user"
}


review_environment()
{
    review_system_config
    review_services

    echo
    echo "No system configuration was modified."
}


# ---------------------------------------------------------------------------
# Usage
# ---------------------------------------------------------------------------

usage()
{
    cat <<EOF
Usage:

  bootstrap packages
  bootstrap dotfiles
  bootstrap vim
  bootstrap user
  bootstrap system-safe
  bootstrap review
  bootstrap all

Commands:

  packages      Install official/AUR packages and Code extensions
  dotfiles      Restore GNU Stow-managed dotfiles
  vim           Restore pinned Vim plugin repositories and patches
  user          Restore saved user configuration
  system-safe   Restore curated portable system configuration
  review        Compare saved system/service state without modifying it
  all           Run packages, dotfiles, vim, user, then review
                (does NOT restore system configuration)

EOF
}


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

require_arch
require_not_root
require_repo

(( $# <= 1 )) || {
    usage
    exit 2
}

ACTION="${1:-help}"

case "$ACTION" in

    packages)
        install_packages
        ;;

    dotfiles)
        restore_dotfiles
        ;;

    vim)
        restore_vim_plugins
        ;;

    user)
        restore_user_config
        ;;


    system-safe)
        restore_system_safe
        ;;

    review)
        review_environment
        ;;

    all)
        install_packages
        restore_dotfiles
        restore_vim_plugins
        restore_user_config
        review_environment
        ;;

    help|-h|--help)
        usage
        ;;

    *)
        usage
        exit 1
        ;;
esac


echo
echo "--- Bootstrap complete ---"
echo
